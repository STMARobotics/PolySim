{
  "name": "polysim",
  "version": "0.16.1",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=24.0.0"
  },
  "scripts": {
    "dev": "vite --host 127.0.0.1",
    "build": "tsc --noEmit && vite build && npm run build:backend",
    "preview": "node scripts/serve.mjs",
    "standalone": "npm run build:offline && node scripts/build-standalone.mjs",
    "test": "tsx --test tests/*.test.ts",
    "benchmark:piles": "tsx scripts/benchmark-piles.mts",
    "check": "tsc --noEmit",
    "dev:offline": "vite --mode offline --host 127.0.0.1",
    "build:offline": "tsc --noEmit && vite build --mode offline",
    "service:local": "node --env-file-if-exists=service/.env --import tsx service/local-server.ts",
    "test:backend": "tsx --test service/tests/*.test.ts",
    "test:infra": "tsx --test cdk/tests/*.test.ts",
    "cdk:synth": "cdk synth",
    "cdk:diff": "cdk diff \"*\"",
    "cdk:deploy": "cdk deploy --all",
    "deployment:preflight": "node --import tsx scripts/deployment-preflight.mjs",
    "deployment:smoke": "node --import tsx scripts/smoke-production.mjs",
    "verify": "npm run check && npm test && npm run test:backend && npm run build && npm run test:infra && npm run cdk:synth",
    "build:backend": "node scripts/build-backend.mjs",
    "build:frontend": "vite build"
  },
  "dependencies": {
    "@aws-sdk/client-dynamodb": "^3.1174.0",
    "@aws-sdk/client-ssm": "^3.1176.0",
    "@aws-sdk/client-sts": "^3.1174.0",
    "@aws-sdk/lib-dynamodb": "^3.1174.0",
    "@dimforge/rapier3d-compat": "^0.21.0",
    "google-auth-library": "^11.3.4",
    "three": "^0.187.0",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@types/aws-lambda": "^8.10.164",
    "@types/node": "^24.19.2",
    "@types/three": "^0.187.0",
    "aws-cdk": "^2.1149.0",
    "aws-cdk-lib": "2.278.0",
    "constructs": "^10.8.1",
    "esbuild": "^0.28.2",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2",
    "vite": "^8.3.8"
  }
}
