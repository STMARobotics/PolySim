{
  "compilerOptions": {
    "target": "ES2022", "module": "ESNext", "moduleResolution": "Bundler",
    "lib": ["ES2022", "DOM", "WebWorker"], "strict": true,
    "skipLibCheck": true, "esModuleInterop": true, "noEmit": true,
    "allowImportingTsExtensions": true, "allowArbitraryExtensions": true, "types": ["node"]
